module examples.composer-feature-tour
import instruments.piano
import std.harmony.chords

title "Composer feature tour (original study)"
// Original documentation study, authored for the Universal Tablature project.
meter 4/4
tempo 96
scale C major

instrument piano : Piano as "Piano"

section study : 6 bars {
    piano {
        voice music {
            bar {
                using dynamics mf
                tuplet 3:2 { C5 e; D5 e; E5 e }
                F5 q
                G5 h
            }
            bar {
                D5 s
                E5 s
                C5 q.
                ornament trill s { D5 h }
            }
            bar {
                dynamics p { crescendo to f { C5 q; D5 q; E5 q accent; F5 q } }
            }
            tempo ramp to 120 over w steps 4
            bar {
                chord A/G minor7 h
                chord C dominant7 h alter 5b add 9#
            }
            bar {
                pedal { C4 q; E4 q; G4 q; C5 q letRing }
            }
            bar { rest w }
        }
    }
}

main { study }
